# ==============================================================================
# Pipeline Environment Configuration - "The Memories of Our Home"
# Copy this file to .env and insert your personal API keys.
# DO NOT COMMIT YOUR .env FILE TO VERSION CONTROL!
# ==============================================================================

# Google AI Studio API Key (Free Tier - Gemini 3.8 Flash TTS & Script)
# Obtain free from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Workers AI (Free Tier - FLUX.1 schnell / FLUX.2 klein keyframes)
# Obtain free from: https://dash.cloudflare.com/ -> Workers & Pages -> AI
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Kaggle API Credentials (Optional - For programmatic dispatch of Wan 2.2 / ACE-Step)
# Obtain from: https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_key_here

# Assembly & Audio Mastering Parameters
DEFAULT_ASPECT_RATIO=16:9
TARGET_LUFS=-14.0
TARGET_TRUE_PEAK=-1.0
